# ─────────────────────────────────────────────────────────────────────────────
# Frontend-Vercel/.env.local — VM-specific environment (DO NOT COMMIT .env.local)
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Copy this file to .env.local  (on the VM, NOT on the Host):
#       cp .env.local.example .env.local
#
# 2. Replace 192.168.x.x with the Host OS LAN IP you found in STEP 3.
#       Run `ipconfig` (Windows) or `ip a` (Linux/macOS) on the HOST.
#
# 3. Restart Vite (`npm run dev`) after editing this file.
# ─────────────────────────────────────────────────────────────────────────────

# Laravel API running on the Host OS (php artisan serve --host=0.0.0.0 --port=8000)
VITE_API_BASE_URL=http://192.168.x.x:8000
